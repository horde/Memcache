{
    "name": "horde/memcache",
    "description": "Memcache client library",
    "type": "library",
    "homepage": "https://www.horde.org/libraries/Horde_Memcache",
    "license": "LGPL-2.1",
    "authors": [
        {
            "name": "Michael Slusarz",
            "email": "slusarz@horde.org",
            "role": "lead"
        }
    ],
    "keywords": [
        "in-memory",
        "psr-16"
    ],
    "time": "2026-04-01",
    "repositories": [],
    "require": {
        "php": "^8.2",
        "horde/exception": "^3 || dev-FRAMEWORK_6_0",
        "psr/simple-cache": "^3.0",
        "psr/log": "^3.0",
        "ext-hash": "*"
    },
    "require-dev": {
        "horde/test": "^3 || dev-FRAMEWORK_6_0",
        "horde/log": "^3 || dev-FRAMEWORK_6_0"
    },
    "suggest": {
        "ext-memcache": "^2",
        "ext-memcached": "*"
    },
    "autoload": {
        "psr-0": {
            "Horde_Memcache": "lib/"
        },
        "psr-4": {
            "Horde\\Memcache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Memcache\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "3.x-dev"
        }
    }
}